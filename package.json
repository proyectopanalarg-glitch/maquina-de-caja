    "test": "node test/motor.test.mjs && node test/mcp.test.mjs",
    "balance": "node test/balance.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pyme",
    "argentina",
    "flujo de caja",
    "juego",
    "metalmecanica"
  ],
