{
  "name": "maquina-caja-pyme",
  "version": "3.0.0",
  "description": "La Máquina de Caja: juego educativo de flujo de caja para Pymes metalmecánicas argentinas, con la economía real actualizada todos los días. Juego web + MCP server, sin dependencias.",
  "type": "module",
  "bin": {
    "maquina-caja-mcp": "mcp/server.mjs"
  },
  "scripts": {
    "datos": "node datos/actualizar.mjs",
    "build": "node build.mjs",
